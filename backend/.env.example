# Copy this file to .env and fill in your own values. Never commit .env!

# AI keys — at least one is required.
# Main (fast, free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Backup: https://aistudio.google.com/
GEMINI_API_KEY=
# Optional: provider order (default groq,gemini)
# AI_PROVIDERS=groq,gemini

PORT=3000

# Gmail sending (see README → First-time setup → Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only allow your extension to call the API (ID from chrome://extensions)
# ALLOWED_EXTENSION_ID=

# Optional: only needed for backend/test-openai.js
# OPENAI_API_KEY=
