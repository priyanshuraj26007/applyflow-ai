# Copy this file to .env and fill in your own values. Never commit .env!

# Required — get a key at https://aistudio.google.com/
GEMINI_API_KEY=

PORT=3000

# Gmail sending (see README → First-time setup → Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only allow your extension to call the API (ID from chrome://extensions)
# ALLOWED_EXTENSION_ID=

# Optional: only needed for backend/test-openai.js
# OPENAI_API_KEY=
