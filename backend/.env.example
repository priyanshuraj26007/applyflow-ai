# ==========================================
# ApplyFlow AI backend settings
# ==========================================
# On your PC: copy this file to .env and fill it in. Never commit .env!
# On Vercel: add the same names under Project → Settings → Environment Variables.

# ---------- Hosted (Vercel) ----------
# The public address of this backend, no trailing slash. Used for the Gmail redirect.
# PUBLIC_URL=https://applyflow-ai.vercel.app
# Supabase (project → Project Settings → API Keys). Run supabase/schema.sql once first.
# The SECRET key (sb_secret_…) stays on the server only — never put it in the extension.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SECRET_KEY=

# ---------- AI keys ----------
# Testers paste their own Groq key in Dashboard → Settings.
# These are only a fallback for YOUR PC. Leave them empty on Vercel,
# otherwise every tester would use (and use up) your key.
# Main (fast, free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Backup: https://aistudio.google.com/
GEMINI_API_KEY=
# Optional: provider order (default groq,gemini)
# AI_PROVIDERS=groq,gemini

PORT=3000

# ---------- Gmail sending ----------
# Google Cloud → Credentials → OAuth client ID.
#   Vercel: type "Web application", redirect URI <PUBLIC_URL>/auth/google/callback
#   Your PC: type "Desktop app"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only allow your extension to call the API (ID from chrome://extensions)
# ALLOWED_EXTENSION_ID=

# Optional: only needed for backend/test-openai.js
# OPENAI_API_KEY=
